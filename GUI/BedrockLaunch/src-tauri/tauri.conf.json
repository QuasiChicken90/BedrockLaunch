{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bedrocklaunch",
  "version": "0.1.0",
  "identifier": "qc",
  "build": {
    "devUrl": "http://localhost:21934",
    "frontendDist": "http://localhost:21934"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "bedrocklaunch",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
